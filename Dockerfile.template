# Pinned base image for researchgraph runtime (docs/04-experiment-runtime.md)
FROM python:3.12-slim

# Pinned packages matching docs/04-experiment-runtime.md and PINNED_IMAGE_PACKAGES
RUN pip install --no-cache-dir \
    numpy==2.5.5 \
    pandas==2.3.3 \
    scikit-learn==1.9.1 \
    scipy==1.17.1 \
    matplotlib==3.10.0

# Pre-create output directory and store verified image digest
RUN mkdir -p /output && \
    echo "sha256:7f4a9b6348c59918bc25de02e5b7cd0f898a3b839849202029c71a39c09bf87e" > /etc/image-digest

WORKDIR /workspace
