# Pinned base image for researchgraph runtime (docs/04-experiment-runtime.md)
FROM python:3.12-slim

# Pinned packages matching docs/04-experiment-runtime.md and PINNED_IMAGE_PACKAGES
RUN pip install --no-cache-dir \
    numpy==2.5.5 \
    pandas==2.3.3 \
    scikit-learn==1.9.1 \
    scipy==1.17.1 \
    matplotlib==3.10.0

# Pre-create the output directory and make it writable by the sandbox user.
# E2B appends `USER user` after these steps, so a root-owned /output would make
# `open('/output/metrics.json', 'w')` fail with EACCES. This mirrors the local
# Docker hardening in docs/04 (chmod 0o777 on /output).
# /etc/image-digest is populated by the build pipeline when the pinned template is published
RUN mkdir -p /output && chmod 777 /output

WORKDIR /workspace
