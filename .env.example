# Neon Database Connection String (pgvector-enabled Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-example.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth Service Base URL (no trailing slash, HTTPS required)
NEON_AUTH_BASE_URL=https://ep-example.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth

# Session Cookie Signing Secret (minimum 32 characters)
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-characters-secret
