# Copy to `.env` (gitignored) or set these in the deploy environment.
# Never commit the real values. On Vercel, add every server-only value under
# Project Settings → Environment Variables (Production and Preview).
# See docs/01-architecture.md and docs/11-deploy.md.

# ---------------------------------------------------------------------------
# Database and auth (required)
# ---------------------------------------------------------------------------

# Application Postgres connection string for the branch whose schema is migrated.
# Use the pooled Neon connection string for a serverless deploy.
DATABASE_URL=

# Managed Better Auth server URL, including the database path, e.g.
# https://<endpoint-id>.<region>.aws.neon.tech/<database>/auth
NEON_AUTH_BASE_URL=

# Signs the cached session cookie (HMAC-SHA256, 32+ characters).
# Generate once with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# The browser client uses `createAuthClient("")`, which resolves to the
# same-origin /api/auth proxy. Do not add a VITE_* auth URL unless the app is
# deliberately moved off the same-origin proxy (see docs/08-auth.md).

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------

# Google Gemini API key for embeddings (`gemini-embedding-2`) and Gemini text calls
# (`gemini-3.8-flash`, evaluator `gemini-4-hydrogen`).
# `GEMINI_API_KEY` is accepted as an alias for embeddings and text calls, but
# this is the documented name; set it in a deploy.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional explicit Meta Model API key (`muse-spark-1.3-contributor` only, ADR 0014).
# When set, general pipeline text calls use Meta instead of `gemini-3.8-flash`;
# `explain_gap` (`gemini-4-hydrogen`) and embeddings stay on Google Gemini.
# The model actually used is recorded on every `agent_tasks.model` row and is
# returned by GET /api/strategies.
META_API_KEY=

# ---------------------------------------------------------------------------
# Experiment execution and ingestion
# ---------------------------------------------------------------------------

# E2B API key. The runner creates `researchgraph-python:locked` sandboxes with
# networking disabled. Required for EXECUTE; without it a run fails before the
# script starts (it cannot be repaired by rewriting the script).
E2B_API_KEY=

# Firecrawl API key for project pages and repository READMEs. Required only for
# the Firecrawl ingestion path.
FIRECRAWL_API_KEY=

# Optional Firecrawl-compatible base URL (self-hosted or a proxy). Omit to use
# the public https://api.firecrawl.dev endpoint.
FIRECRAWL_API_URL=
