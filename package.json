{
  "name": "research-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/seed/tsconfig.json",
    "test": "node --test \"src/server/pipeline-transport/*.test.ts\" && vitest run && vitest run --config scripts/seed/vitest.config.ts",
    "verify:hero": "node scripts/verify-hero-run.mjs",
    "seed": "node scripts/seed/loader.mjs",
    "seed:compare": "node scripts/seed/compare-loader.mjs",
    "seed:check": "tsc --noEmit -p scripts/seed/tsconfig.json",
    "seed:test": "vitest run --config scripts/seed/vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node src/db/bootstrap.mjs && drizzle-kit push",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.124",
    "@ai-sdk/openai-compatible": "3.0.96",
    "@ai-sdk/react": "4.0.184",
    "@neon/auth": "0.8.2",
    "@neondatabase/serverless": "1.2.1",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@xyflow/react": "13.0.3",
    "ai": "7.0.179",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "e2b": "2.64.0",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.0.2",
    "tailwindcss": "4.1.18",
    "unpdf": "2.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.16",
    "@types/node": "26.6.6",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "nitro": "3.0.261103-rc",
    "pg": "8.16.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
