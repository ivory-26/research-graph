    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "@xyflow/react": "13.0.3",
    "ai": "7.0.179",
    "drizzle-orm": "0.45.4",
    "e2b": "2.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "2.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
